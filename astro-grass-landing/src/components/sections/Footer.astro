---
import Container from '@/components/ui/Container.astro';
import { locations } from '@/data/locations';

const navLinks = [
  { label: 'Servicios', href: '#servicios' },
  { label: 'Productos', href: '#productos' },
  { label: 'Beneficios', href: '#beneficios' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Sucursales', href: '#sucursales' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Cotizar', href: '#cotizar' },
];
---

<footer class="bg-ink-900 text-white pt-16 pb-8" role="contentinfo">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 pb-12 border-b border-ink-800">
      <!-- Columna 1: Logo + descripción + redes -->
      <div class="space-y-6">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-grass-500 rounded-lg flex items-center justify-center" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22c-4.97 0-9-4.03-9-9 0-4.97 4.03-9 9-9s9 4.03 9 9c0 4.97-4.03 9-9 9z"/>
              <path d="M7 13s.5-3 5-3 5 3 5 3"/>
              <path d="M12 10v3"/>
            </svg>
          </div>
          <span class="font-heading font-bold text-xl tracking-tight">Astro<span class="text-grass-400">Grass</span></span>
        </div>
        <p class="text-ink-400 text-sm leading-relaxed">
          Importadores, distribuidores e instaladores de césped artificial sintético y pisos de caucho en Ecuador. Una marca de Astro Global Corp.
        </p>
        <!-- Redes sociales -->
        <div class="flex items-center gap-4">
          <a
            href="https://www.instagram.com/astroglobalcorp"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-ink-800 rounded-xl flex items-center justify-center text-ink-400 hover:text-white hover:bg-grass-600 transition-all"
            aria-label="Seguir a Astro Grass en Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/AstroGrassEc"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-ink-800 rounded-xl flex items-center justify-center text-ink-400 hover:text-white hover:bg-grass-600 transition-all"
            aria-label="Seguir a Astro Grass en Facebook"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a
            href="https://api.whatsapp.com/send?phone=593969643366&text=Hola%2C+me+interesa+m%C3%A1s+informaci%C3%B3n+sobre+Astro+Grass."
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-ink-800 rounded-xl flex items-center justify-center text-ink-400 hover:text-white hover:bg-[#25D366] transition-all"
            aria-label="Contactar a Astro Grass por WhatsApp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Links rápidos -->
      <nav aria-label="Navegación de pie de página">
        <p class="text-sm font-semibold text-white uppercase tracking-widest mb-4">Navegación</p>
        <ul class="space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-400 hover:text-grass-400 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Columna 3: Contacto -->
      <div>
        <p class="text-sm font-semibold text-white uppercase tracking-widest mb-4">Contáctanos</p>
        <div class="space-y-4">
          <a
            href="mailto:astrograssec@hotmail.com"
            class="flex items-center gap-2 text-sm text-ink-400 hover:text-grass-400 transition-colors"
            aria-label="Enviar correo a Astro Grass"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            astrograssec@hotmail.com
          </a>
          {
            locations.map((loc) => (
              <div>
                <p class="text-xs font-semibold text-grass-400 mb-1">{loc.city}</p>
                <a
                  href={`tel:${loc.whatsapp}`}
                  class="text-sm text-ink-400 hover:text-grass-400 transition-colors"
                  aria-label={`Llamar a sucursal ${loc.city}`}
                >
                  {loc.phone}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Línea inferior -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-ink-500">
      <p>© 2026 Astro Global Corp · Todos los derechos reservados · Una marca ecuatoriana 🇪🇨</p>
      <p>Diseñado para campañas de alta conversión</p>
    </div>
  </Container>
</footer>
