---
import Container from '@/components/ui/Container.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Button from '@/components/ui/Button.astro';
import { locations } from '@/data/locations';
import { buildWhatsAppUrl, type WhatsAppCity } from '@/lib/whatsapp';
---

<section
  id="sucursales"
  class="py-20 md:py-32 bg-cream"
  aria-label="Nuestras sucursales"
  role="region"
  aria-labelledby="locations-heading"
>
  <Container>
    <SectionTitle
      id="locations-heading"
      eyebrow="Dónde encontrarnos"
      title="3 ciudades, un mismo compromiso"
      description="Visita nuestro showroom de 5.000 m² o agenda una visita técnica directamente desde WhatsApp. Estamos en Quito, Guayaquil y Portoviejo."
      class="mb-16"
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
      {
        locations.map((loc) => {
          const waUrl = buildWhatsAppUrl(
            loc.id as WhatsAppCity,
            `Hola, me interesa visitar su sucursal en ${loc.city} o agendar una asesoría. ¿Cuándo puedo visitarlos?`
          );

          return (
            <article class="bg-white rounded-2xl overflow-hidden border border-ink-100 hover:shadow-lg hover:border-grass-200 transition-all duration-300 flex flex-col">
              <!-- Mapa iframe -->
              <div class="relative h-52 bg-grass-100">
                <iframe
                  src={loc.mapUrl}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Mapa de sucursal Astro Grass ${loc.city}`}
                  class="w-full h-full"
                />
              </div>

              <div class="p-6 flex flex-col gap-4 flex-1">
                <!-- Ciudad -->
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-grass-500 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-ink-900">{loc.city}</h3>
                </div>

                <!-- Dirección -->
                <address class="not-italic text-sm text-ink-600 leading-relaxed">
                  {loc.address}
                </address>

                <!-- Teléfono -->
                <a
                  href={`tel:${loc.whatsapp}`}
                  class="flex items-center gap-2 text-sm font-semibold text-grass-600 hover:text-grass-700 transition-colors"
                  aria-label={`Llamar a sucursal ${loc.city}: ${loc.phone}`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.18 2 2 0 0 1 3.59 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l.61-.61a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  {loc.phone}
                </a>

                <!-- Horario -->
                <p class="text-xs text-ink-400">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block mr-1" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  Lunes a Sábado · 8:00 – 18:00
                </p>

                <!-- CTA WhatsApp -->
                <div class="mt-auto">
                  <Button
                    href={waUrl}
                    target="_blank"
                    variant="whatsapp"
                    size="sm"
                    class="w-full"
                    aria-label={`Abrir WhatsApp con sucursal ${loc.city}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                    WhatsApp {loc.city}
                  </Button>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>
