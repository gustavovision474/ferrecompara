---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { buildWhatsAppUrl } from '@/lib/whatsapp';

const whatsappUrl = buildWhatsAppUrl(
  'portoviejo',
  '¡Hola! Quiero cotizar césped artificial para mi proyecto. ¿Me pueden ayudar?'
);
---

<section
  class="relative min-h-screen flex items-center pt-16 md:pt-20 bg-white overflow-hidden"
  aria-label="Presentación principal"
  role="region"
  aria-labelledby="hero-heading"
>
  <!-- Fondo decorativo sutil -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-grass-50 rounded-bl-[120px]"></div>
    <div class="absolute bottom-20 left-10 w-64 h-64 bg-grass-100 rounded-full blur-3xl opacity-40"></div>
  </div>

  <Container class="relative grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-center py-20 md:py-32">
    <!-- Columna de texto (60%) -->
    <div class="lg:col-span-3 space-y-8">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 bg-grass-100 text-grass-700 px-4 py-2 rounded-full text-sm font-semibold">
        <span class="w-2 h-2 bg-grass-500 rounded-full animate-pulse" aria-hidden="true"></span>
        Importadores oficiales · Ecuador
      </div>

      <!-- H1 -->
      <h1
        id="hero-heading"
        class="text-5xl md:text-6xl lg:text-7xl font-bold text-ink-900 leading-tight tracking-tight"
      >
        Césped artificial<br />
        <span class="text-grass-500">profesional</span><br />
        para canchas,<br />
        parques y hogares
      </h1>

      <!-- Subtítulo -->
      <p class="text-lg md:text-xl text-ink-600 leading-relaxed max-w-xl">
        Instalación garantizada en Quito, Guayaquil y Portoviejo. Más de 10 años de durabilidad con certificación internacional ISO 9001 y ASTM.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4">
        <Button
          href={whatsappUrl}
          target="_blank"
          variant="whatsapp"
          size="lg"
          aria-label="Cotizar por WhatsApp con Astro Grass"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Cotizar por WhatsApp
        </Button>
        <Button href="#productos" variant="outline" size="lg" aria-label="Ver catálogo de productos">
          Ver productos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </Button>
      </div>

      <!-- Trust signals -->
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-500">
        <span class="flex items-center gap-1.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-grass-500" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Garantía hasta 10 años
        </span>
        <span class="flex items-center gap-1.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-grass-500" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Showroom 5.000 m²
        </span>
        <span class="flex items-center gap-1.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-grass-500" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Instalación en todo Ecuador
        </span>
      </div>
    </div>

    <!-- Columna visual (40%) -->
    <div class="lg:col-span-2 relative">
      <div class="relative rounded-3xl overflow-hidden aspect-[4/5]">
        <img
          src="https://placehold.co/800x1000/3D8526/FFFFFF?text=Césped+Astro+Grass"
          alt="Cancha de fútbol con césped artificial instalado por Astro Grass en Ecuador"
          width="800"
          height="1000"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
        <!-- Overlay sutil -->
        <div class="absolute inset-0 bg-gradient-to-t from-grass-900/30 to-transparent" aria-hidden="true"></div>
      </div>

      <!-- Tarjeta flotante de stat -->
      <div
        id="hero-stat-card"
        class="absolute -bottom-6 -left-6 bg-white rounded-2xl shadow-xl p-4 border border-ink-100 opacity-0 translate-y-4"
        aria-label="Proyectos instalados"
      >
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-grass-100 rounded-xl flex items-center justify-center" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-grass-600">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-ink-900">+500</p>
            <p class="text-sm text-ink-500">proyectos instalados</p>
          </div>
        </div>
      </div>

      <!-- Badge de garantía -->
      <div
        class="absolute -top-4 -right-4 bg-grass-500 text-white rounded-2xl shadow-lg px-4 py-3 text-center"
        aria-label="Garantía de 5 años"
      >
        <p class="text-2xl font-bold leading-none">5</p>
        <p class="text-xs font-medium leading-none mt-0.5">años garantía</p>
      </div>
    </div>
  </Container>
</section>

<script is:inline>
  // Animación de fade-in de la tarjeta stat
  const statCard = document.getElementById('hero-stat-card');
  if (statCard && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setTimeout(() => {
      statCard.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      statCard.style.opacity = '1';
      statCard.style.transform = 'translateY(0)';
    }, 800);
  } else if (statCard) {
    statCard.style.opacity = '1';
    statCard.style.transform = 'translateY(0)';
  }
</script>
