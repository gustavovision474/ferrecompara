---
import { cn } from '@/lib/utils';

interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'whatsapp';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  'aria-label'?: string;
  id?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  disabled = false,
  class: className,
  'aria-label': ariaLabel,
  id,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none rounded-xl cursor-pointer';

const variants: Record<string, string> = {
  primary:
    'bg-grass-500 text-white hover:bg-grass-600 focus-visible:ring-grass-500 shadow-sm hover:shadow-md',
  secondary:
    'bg-grass-100 text-grass-800 hover:bg-grass-200 focus-visible:ring-grass-400',
  outline:
    'border-2 border-grass-500 text-grass-600 hover:bg-grass-50 focus-visible:ring-grass-500 bg-transparent',
  ghost:
    'text-grass-600 hover:bg-grass-50 focus-visible:ring-grass-400 bg-transparent',
  whatsapp:
    'bg-[#25D366] text-white hover:bg-[#20BD5C] focus-visible:ring-[#25D366] shadow-sm hover:shadow-md',
};

const sizes: Record<string, string> = {
  sm: 'text-sm px-4 py-2',
  md: 'text-base px-6 py-3',
  lg: 'text-lg px-8 py-4',
};

const classes = cn(base, variants[variant], sizes[size], className);
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined)}
      class={classes}
      aria-label={ariaLabel}
      id={id}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      class={classes}
      aria-label={ariaLabel}
      id={id}
      {...rest}
    >
      <slot />
    </button>
  )
}
