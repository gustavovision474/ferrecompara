---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
}

const { class: className, padding = 'md', hover = false } = Astro.props;

const paddings: Record<string, string> = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const classes = cn(
  'bg-white rounded-2xl border border-ink-100',
  paddings[padding],
  hover && 'transition-shadow duration-200 hover:shadow-lg hover:-translate-y-0.5 hover:border-grass-200',
  className
);
---

<div class={classes}>
  <slot />
</div>
