---
import Container from '@/components/ui/Container.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';

const steps = [
  {
    number: '01',
    title: 'Cotización',
    description:
      'Solicita tu cotización por WhatsApp o formulario en menos de 2 minutos. Sin compromiso ni datos innecesarios.',
    icon: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
  },
  {
    number: '02',
    title: 'Visita técnica',
    description:
      'Coordinamos visita gratuita al sitio para mediciones precisas y asesoría personalizada del modelo más adecuado.',
    icon: `<circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>`,
  },
  {
    number: '03',
    title: 'Diseño y propuesta',
    description:
      'Elaboramos una propuesta personalizada con producto, cronograma y precio cerrado. Sin sorpresas al final.',
    icon: `<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>`,
  },
  {
    number: '04',
    title: 'Instalación',
    description:
      'Nuestro equipo técnico certificado instala con garantía completa. Limpiamos y dejamos el espacio listo para usar.',
    icon: `<path d="m15 14 5-5-5-5"/><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13"/>`,
  },
];
---

<section
  class="py-20 md:py-32 bg-cream"
  aria-label="Proceso de instalación"
  role="region"
  aria-labelledby="process-heading"
>
  <Container>
    <SectionTitle
      id="process-heading"
      eyebrow="Cómo trabajamos"
      title="Del primer mensaje al césped instalado"
      description="Un proceso simple y transparente, sin burocracia. Del contacto inicial a la entrega en 4 pasos."
      class="mb-16"
    />

    <div class="relative">
      <!-- Línea conectora (desktop) -->
      <div
        class="hidden lg:block absolute top-10 left-[12.5%] right-[12.5%] h-0.5 border-t-2 border-dashed border-grass-300"
        aria-hidden="true"
      ></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
        {
          steps.map((step) => (
            <div class="flex flex-col items-center text-center lg:items-center gap-4">
              <!-- Número en círculo -->
              <div class="relative z-10 w-20 h-20 bg-grass-500 rounded-full flex items-center justify-center shadow-lg shadow-grass-200">
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <Fragment set:html={step.icon} />
                </svg>
              </div>

              <div>
                <p class="text-xs font-bold text-grass-500 uppercase tracking-widest mb-1">{step.number}</p>
                <h3 class="text-lg font-bold text-ink-900 mb-2">{step.title}</h3>
                <p class="text-sm text-ink-600 leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>
