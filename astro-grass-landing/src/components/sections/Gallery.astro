---
import Container from '@/components/ui/Container.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';

const projects = [
  {
    name: 'Parque La California',
    location: 'Portoviejo',
    type: 'Parque municipal',
    color: '3D8526',
    size: 'large',
  },
  {
    name: 'Cancha de pádel',
    location: 'Quito',
    type: 'Canchas deportivas',
    color: '2E6A1C',
    size: 'small',
  },
  {
    name: 'Escuela Leopoldo Isquieta Pérez',
    location: 'Portoviejo',
    type: 'Área escolar',
    color: '245216',
    size: 'small',
  },
  {
    name: 'Parque San Gregorio',
    location: 'Guayaquil',
    type: 'Parque municipal',
    color: '5FA248',
    size: 'large',
  },
  {
    name: 'Área de piscina residencial',
    location: 'Guayaquil',
    type: 'Jardín residencial',
    color: '8FBE7F',
    size: 'small',
  },
  {
    name: 'Cancha de fútbol sala',
    location: 'Guayaquil',
    type: 'Canchas deportivas',
    color: '1B3F11',
    size: 'small',
  },
];
---

<section
  id="proyectos"
  class="py-20 md:py-32 bg-white"
  aria-label="Proyectos realizados"
  role="region"
  aria-labelledby="gallery-heading"
>
  <Container>
    <SectionTitle
      id="gallery-heading"
      eyebrow="Proyectos realizados"
      title="Más de 500 espacios transformados"
      description="Canchas deportivas, parques públicos, colegios, residencias. Cada proyecto, una historia de satisfacción garantizada."
      class="mb-16"
    />

    <!-- Grid asimétrico de galería -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
      {
        projects.map((project) => {
          const isLarge = project.size === 'large';
          const spanClass = isLarge ? 'md:col-span-2' : '';
          return (
            <article class={`group relative rounded-2xl overflow-hidden aspect-[4/3] ${spanClass}`}>
              <img
                src={`https://placehold.co/800x600/${project.color}/FFFFFF?text=${encodeURIComponent(project.name)}`}
                alt={`${project.type} — ${project.name}, ${project.location}`}
                width="800"
                height="600"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <!-- Overlay con info -->
              <div class="absolute inset-0 bg-gradient-to-t from-grass-900/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <div class="absolute bottom-0 left-0 right-0 p-4 text-white">
                  <p class="text-xs font-medium text-grass-300 uppercase tracking-wide mb-1">{project.type}</p>
                  <p class="font-bold text-base leading-tight">{project.name}</p>
                  <p class="text-sm text-grass-200">{project.location}</p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <p class="text-ink-500 text-sm mb-4">¿Quieres ver tu proyecto aquí?</p>
      <a
        href="#cotizar"
        class="text-grass-600 font-semibold hover:text-grass-700 text-base transition-colors"
        aria-label="Solicitar cotización para tu proyecto"
      >
        Solicita tu cotización →
      </a>
    </div>
  </Container>
</section>
