---
import Container from '@/components/ui/Container.astro';
---

<section
  id="cotizar"
  class="py-20 md:py-32 bg-grass-700"
  aria-label="Formulario de cotización"
  role="region"
  aria-labelledby="form-heading"
>
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Texto motivacional -->
      <div class="space-y-6">
        <p class="text-grass-300 text-sm font-semibold uppercase tracking-widest">Cotiza sin compromiso</p>
        <h2 id="form-heading" class="text-3xl md:text-5xl font-bold text-white leading-tight">
          Tu proyecto merece el mejor césped
        </h2>
        <p class="text-grass-100 text-lg leading-relaxed">
          Completa el formulario y un asesor especializado te contactará en menos de 4 horas con la mejor propuesta para tu espacio.
        </p>

        <ul class="space-y-4">
          {[
            'Cotización personalizada y sin compromiso',
            'Respuesta en menos de 4 horas hábiles',
            'Asesoría técnica gratuita incluida',
            'Instalación con garantía completa',
          ].map((item) => (
            <li class="flex items-center gap-3 text-grass-100">
              <span class="w-6 h-6 bg-grass-500 rounded-full flex items-center justify-center shrink-0" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Formulario -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-2xl">
        <form
          id="lead-form"
          novalidate
          aria-label="Formulario de cotización de césped artificial"
        >
          <!-- Honeypot anti-bot (oculto) -->
          <input
            type="text"
            name="website"
            id="website"
            autocomplete="off"
            tabindex="-1"
            aria-hidden="true"
            style="position:absolute;left:-9999px;opacity:0;pointer-events:none;"
          />

          <div class="space-y-4">
            <!-- Nombre -->
            <div>
              <label for="nombre" class="block text-sm font-semibold text-ink-700 mb-1.5">
                Nombre completo <span class="text-red-500" aria-label="requerido">*</span>
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                autocomplete="name"
                placeholder="Tu nombre completo"
                class="w-full px-4 py-3 rounded-xl border border-ink-200 text-ink-800 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-grass-500 focus:border-transparent transition-all text-sm"
                aria-required="true"
              />
              <p class="hidden mt-1 text-xs text-red-500" role="alert" id="nombre-error">Por favor ingresa tu nombre completo.</p>
            </div>

            <!-- Teléfono -->
            <div>
              <label for="telefono" class="block text-sm font-semibold text-ink-700 mb-1.5">
                Teléfono / WhatsApp <span class="text-red-500" aria-label="requerido">*</span>
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                required
                autocomplete="tel"
                placeholder="0999 999 999"
                pattern="^[0-9+\s\-()]{7,15}$"
                class="w-full px-4 py-3 rounded-xl border border-ink-200 text-ink-800 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-grass-500 focus:border-transparent transition-all text-sm"
                aria-required="true"
              />
              <p class="hidden mt-1 text-xs text-red-500" role="alert" id="telefono-error">Por favor ingresa un número de teléfono válido.</p>
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-ink-700 mb-1.5">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                placeholder="tu@correo.com"
                class="w-full px-4 py-3 rounded-xl border border-ink-200 text-ink-800 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-grass-500 focus:border-transparent transition-all text-sm"
              />
            </div>

            <!-- Ciudad y tipo de proyecto (fila) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="ciudad" class="block text-sm font-semibold text-ink-700 mb-1.5">
                  Ciudad <span class="text-red-500" aria-label="requerida">*</span>
                </label>
                <select
                  id="ciudad"
                  name="ciudad"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-ink-200 text-ink-800 focus:outline-none focus:ring-2 focus:ring-grass-500 focus:border-transparent transition-all text-sm bg-white"
                  aria-required="true"
                >
                  <option value="" disabled selected>Selecciona</option>
                  <option value="Quito">Quito</option>
                  <option value="Guayaquil">Guayaquil</option>
                  <option value="Portoviejo">Portoviejo</option>
                  <option value="Otra">Otra ciudad</option>
                </select>
                <p class="hidden mt-1 text-xs text-red-500" role="alert" id="ciudad-error">Selecciona tu ciudad.</p>
              </div>

              <div>
                <label for="tipo-proyecto" class="block text-sm font-semibold text-ink-700 mb-1.5">
                  Tipo de proyecto <span class="text-red-500" aria-label="requerido">*</span>
                </label>
                <select
                  id="tipo-proyecto"
                  name="tipo_proyecto"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-ink-200 text-ink-800 focus:outline-none focus:ring-2 focus:ring-grass-500 focus:border-transparent transition-all text-sm bg-white"
                  aria-required="true"
                >
                  <option value="" disabled selected>Selecciona</option>
                  <option value="Cancha deportiva">Cancha deportiva</option>
                  <option value="Parque o juegos">Parque o juegos</option>
                  <option value="Jardín residencial">Jardín residencial</option>
                  <option value="Gimnasio">Gimnasio</option>
                  <option value="Otro">Otro</option>
                </select>
                <p class="hidden mt-1 text-xs text-red-500" role="alert" id="tipo-error">Selecciona el tipo de proyecto.</p>
              </div>
            </div>

            <!-- Metros cuadrados -->
            <div>
              <label for="metros" class="block text-sm font-semibold text-ink-700 mb-1.5">
                Metros cuadrados aproximados
                <span class="text-ink-400 font-normal">(opcional)</span>
              </label>
              <input
                type="number"
                id="metros"
                name="metros"
                min="1"
                max="999999"
                placeholder="Ej: 150"
                class="w-full px-4 py-3 rounded-xl border border-ink-200 text-ink-800 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-grass-500 focus:border-transparent transition-all text-sm"
              />
            </div>

            <!-- Mensaje -->
            <div>
              <label for="mensaje" class="block text-sm font-semibold text-ink-700 mb-1.5">
                Mensaje <span class="text-ink-400 font-normal">(opcional)</span>
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="3"
                placeholder="Cuéntanos más sobre tu proyecto..."
                class="w-full px-4 py-3 rounded-xl border border-ink-200 text-ink-800 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-grass-500 focus:border-transparent transition-all text-sm resize-none"
              ></textarea>
            </div>

            <!-- Checkbox WhatsApp -->
            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="acepta-whatsapp"
                name="acepta_whatsapp"
                required
                class="mt-0.5 w-4 h-4 text-grass-600 border-ink-300 rounded focus:ring-grass-500"
                aria-required="true"
              />
              <label for="acepta-whatsapp" class="text-xs text-ink-600 leading-relaxed cursor-pointer">
                Acepto ser contactado por WhatsApp y/o email para recibir la cotización de mi proyecto.
                <span class="text-red-500" aria-label="requerido">*</span>
              </label>
            </div>
            <p class="hidden mt-1 text-xs text-red-500" role="alert" id="acepta-error">Debes aceptar ser contactado para continuar.</p>
          </div>

          <!-- Estado del formulario -->
          <div id="form-status" class="hidden mt-4 p-4 rounded-xl text-sm font-medium" role="status" aria-live="polite"></div>

          <!-- Submit -->
          <div class="mt-6">
            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-accent text-white font-bold py-4 rounded-xl hover:bg-[#d4922e] transition-colors text-base flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
              aria-label="Enviar cotización"
            >
              <svg id="submit-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
              <svg id="submit-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden animate-spin" aria-hidden="true">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
              </svg>
              <span id="submit-text">Solicitar cotización gratis</span>
            </button>
          </div>
        </form>

        <!-- Mensaje de éxito -->
        <div id="form-success" class="hidden text-center py-8 space-y-4">
          <div class="w-16 h-16 bg-grass-100 rounded-full flex items-center justify-center mx-auto" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-grass-600">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-ink-900">¡Cotización recibida!</h3>
          <p class="text-ink-600 text-sm">Te contactaremos en menos de 4 horas con una propuesta personalizada.</p>
          <a
            id="success-whatsapp"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-xl font-semibold text-sm hover:bg-[#20BD5C] transition-colors"
            aria-label="Continuar la conversación por WhatsApp"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Continuar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>

<script is:inline>
  const form = document.getElementById('lead-form');
  const formSuccess = document.getElementById('form-success');
  const formStatus = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');
  const submitIcon = document.getElementById('submit-icon');
  const submitSpinner = document.getElementById('submit-spinner');
  const submitText = document.getElementById('submit-text');
  const successWa = document.getElementById('success-whatsapp');

  function showError(fieldId, errorId, show) {
    const field = document.getElementById(fieldId);
    const error = document.getElementById(errorId);
    if (!field || !error) return;
    if (show) {
      field.classList.add('border-red-400', 'focus:ring-red-400');
      error.classList.remove('hidden');
    } else {
      field.classList.remove('border-red-400', 'focus:ring-red-400');
      error.classList.add('hidden');
    }
  }

  function validateForm(data) {
    let valid = true;
    if (!data.get('nombre')?.toString().trim()) {
      showError('nombre', 'nombre-error', true);
      valid = false;
    } else {
      showError('nombre', 'nombre-error', false);
    }
    const tel = data.get('telefono')?.toString().trim() ?? '';
    if (!tel || !/^[0-9+\s\-()]{7,15}$/.test(tel)) {
      showError('telefono', 'telefono-error', true);
      valid = false;
    } else {
      showError('telefono', 'telefono-error', false);
    }
    if (!data.get('ciudad')) {
      showError('ciudad', 'ciudad-error', true);
      valid = false;
    } else {
      showError('ciudad', 'ciudad-error', false);
    }
    if (!data.get('tipo_proyecto')) {
      showError('tipo-proyecto', 'tipo-error', true);
      valid = false;
    } else {
      showError('tipo-proyecto', 'tipo-error', false);
    }
    if (!data.get('acepta_whatsapp')) {
      document.getElementById('acepta-error').classList.remove('hidden');
      valid = false;
    } else {
      document.getElementById('acepta-error').classList.add('hidden');
    }
    return valid;
  }

  function setLoading(loading) {
    submitBtn.disabled = loading;
    submitIcon.classList.toggle('hidden', loading);
    submitSpinner.classList.toggle('hidden', !loading);
    submitText.textContent = loading ? 'Enviando...' : 'Solicitar cotización gratis';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!validateForm(data)) return;
    setLoading(true);
    formStatus.classList.add('hidden');

    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();
      if (res.ok) {
        form.classList.add('hidden');
        formSuccess.classList.remove('hidden');
        const nombre = data.get('nombre')?.toString() ?? '';
        const ciudad = data.get('ciudad')?.toString() ?? '';
        const tipo = data.get('tipo_proyecto')?.toString() ?? '';
        const metros = data.get('metros')?.toString() ?? '';
        const waCity = ciudad.toLowerCase().includes('quito') ? '593959162891'
          : ciudad.toLowerCase().includes('guayaquil') ? '593992327666'
          : '593969643366';
        const sqmText = metros ? ` Área: ${metros} m².` : '';
        const msg = encodeURIComponent(`Hola, soy ${nombre}. Acabo de enviar una cotización desde la web.\nCiudad: ${ciudad}\nProyecto: ${tipo}${sqmText}\n¿Pueden contactarme?`);
        successWa.href = `https://api.whatsapp.com/send?phone=${waCity}&text=${msg}`;
      } else {
        formStatus.textContent = json.message ?? 'Hubo un error. Inténtalo de nuevo.';
        formStatus.className = 'mt-4 p-4 rounded-xl text-sm font-medium bg-red-50 text-red-600';
        formStatus.classList.remove('hidden');
      }
    } catch {
      formStatus.textContent = 'Error de conexión. Por favor intenta de nuevo.';
      formStatus.className = 'mt-4 p-4 rounded-xl text-sm font-medium bg-red-50 text-red-600';
      formStatus.classList.remove('hidden');
    } finally {
      setLoading(false);
    }
  });
</script>
