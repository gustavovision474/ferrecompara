---
interface Props {
  question: string;
  id?: string;
}

const { question, id } = Astro.props;
---

<details
  class="group border-b border-ink-100 last:border-b-0"
  id={id}
>
  <summary
    class="flex items-center justify-between gap-4 py-5 cursor-pointer list-none select-none hover:text-grass-600 transition-colors duration-200"
    aria-expanded="false"
  >
    <span class="text-base md:text-lg font-semibold text-ink-800 group-open:text-grass-700">
      {question}
    </span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shrink-0 text-grass-500 transition-transform duration-300 group-open:rotate-180"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>
  <div class="pb-5 text-ink-600 leading-relaxed text-base">
    <slot />
  </div>
</details>
