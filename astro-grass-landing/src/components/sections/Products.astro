---
import Container from '@/components/ui/Container.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { products } from '@/data/products';
import { buildProductWhatsAppUrl } from '@/lib/whatsapp';

const colorMap: Record<string, string> = {
  'Verde Oliva': 'bg-[#6B7C3F]',
  'Verde Lima': 'bg-[#8FBE7F]',
  'Verde estándar': 'bg-[#3D8526]',
  'Azul Claro': 'bg-[#5BA4CF]',
  'Azul Oscuro': 'bg-[#1E4D8C]',
  'Amarillo': 'bg-[#F5C518]',
  'Blanco': 'bg-white border border-ink-200',
  'Varios colores disponibles': 'bg-gradient-to-r from-grass-500 via-[#5BA4CF] to-[#F5C518]',
};
---

<section
  id="productos"
  class="py-20 md:py-32 bg-cream"
  aria-label="Catálogo de productos"
  role="region"
  aria-labelledby="products-heading"
>
  <Container>
    <SectionTitle
      id="products-heading"
      eyebrow="Catálogo"
      title="7 modelos para cada necesidad"
      description="Desde canchas FIFA-grade hasta jardines residenciales. Todos nuestros céspedes cuentan con certificación internacional y garantía de 5 años."
      class="mb-16"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        products.map((product) => {
          const waUrl = buildProductWhatsAppUrl(product.name);
          return (
            <article class="bg-white rounded-2xl overflow-hidden border border-ink-100 hover:shadow-lg hover:border-grass-200 transition-all duration-300 flex flex-col">
              <!-- Imagen placeholder del producto -->
              <div class="relative h-48 bg-gradient-to-br from-grass-500 to-grass-700 flex items-center justify-center">
                <div class="text-center text-white px-4">
                  <p class="text-2xl font-bold">{product.name}</p>
                  <p class="text-grass-200 text-sm mt-1">{product.category === 'deportivo' ? 'Deportivo' : 'Decorativo'}</p>
                </div>
                <div class="absolute top-3 right-3">
                  <span class={`text-xs font-bold px-3 py-1 rounded-full ${product.category === 'deportivo' ? 'bg-white/20 text-white' : 'bg-earth-100 text-earth-700'}`}>
                    {product.category === 'deportivo' ? '⚽ Deportivo' : '🌿 Decorativo'}
                  </span>
                </div>
              </div>

              <div class="p-6 flex flex-col gap-4 flex-1">
                <div>
                  <h3 class="text-xl font-bold text-ink-900 mb-2">{product.name}</h3>
                  <p class="text-sm text-ink-600 leading-relaxed">{product.description}</p>
                </div>

                <!-- Colores disponibles -->
                <div>
                  <p class="text-xs font-semibold text-ink-400 uppercase tracking-wide mb-2">Colores disponibles</p>
                  <div class="flex flex-wrap gap-2">
                    {product.colors.map((color) => (
                      <div class="flex items-center gap-1.5">
                        <span
                          class={`w-3 h-3 rounded-full shrink-0 ${colorMap[color] ?? 'bg-grass-400'}`}
                          aria-hidden="true"
                        />
                        <span class="text-xs text-ink-600">{color}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Specs -->
                <div class="bg-ink-50 rounded-xl p-3 space-y-2">
                  <div class="flex justify-between text-xs">
                    <span class="text-ink-400 font-medium">Medidas</span>
                    <span class="text-ink-700 font-semibold text-right max-w-[60%]">{product.dimensions}</span>
                  </div>
                  <div class="flex justify-between text-xs">
                    <span class="text-ink-400 font-medium">Puntadas</span>
                    <span class="text-ink-700 font-semibold">{product.stitches}</span>
                  </div>
                </div>

                <!-- Features -->
                {product.features && (
                  <div class="flex flex-wrap gap-1.5">
                    {product.features.map((feat) => (
                      <Badge variant="grass" class="text-xs">{feat}</Badge>
                    ))}
                  </div>
                )}

                <!-- CTA -->
                <div class="mt-auto pt-2">
                  <Button
                    href={waUrl}
                    target="_blank"
                    variant="whatsapp"
                    size="sm"
                    class="w-full"
                    aria-label={`Cotizar modelo ${product.name} por WhatsApp`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                    Cotizar este modelo
                  </Button>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Nota de precios -->
    <div class="mt-12 text-center">
      <p class="text-ink-500 text-sm">
        Precios desde <strong class="text-ink-800">$9 USD/m²</strong> hasta <strong class="text-ink-800">$15 USD/m²</strong> según modelo y lugar de instalación.
        <a href="#cotizar" class="text-grass-600 font-semibold hover:underline ml-1">Cotiza tu proyecto →</a>
      </p>
    </div>
  </Container>
</section>
