---
import { cn } from '@/lib/utils';

interface Props {
  variant?: 'default' | 'grass' | 'earth' | 'outline' | 'certification';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-ink-100 text-ink-700',
  grass: 'bg-grass-100 text-grass-700',
  earth: 'bg-earth-100 text-earth-700',
  outline: 'border border-ink-200 text-ink-600 bg-transparent',
  certification: 'bg-white border-2 border-grass-500 text-grass-700 font-bold',
};

const classes = cn(
  'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium',
  variants[variant],
  className
);
---

<span class={classes}>
  <slot />
</span>
