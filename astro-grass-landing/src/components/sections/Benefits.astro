---
import Container from '@/components/ui/Container.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { benefits } from '@/data/benefits';

const iconPaths: Record<string, string> = {
  'lucide:piggy-bank': `<path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.8 1.7-1.8 2-3h2v-4h-2c0-1-.5-1.5-1-2z"/><path d="M2 9v1a2 2 0 0 0 2 2h1"/><path d="M16 11h0"/>`,
  'lucide:wrench': `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  'lucide:shield-check': `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  'lucide:leaf': `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  'lucide:heart': `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>`,
  'lucide:sprout': `<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 1 1.1 4.8 4 4 0 0 1-1.4 2.7c-1 .9-2.6 1.4-3.8 1-1-2.7.4-6 4.1-8.5z"/>`,
  'lucide:paw-print': `<circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/>`,
  'lucide:sun': `<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>`,
};
---

<section
  id="beneficios"
  class="py-20 md:py-32 bg-white"
  aria-label="Beneficios del césped artificial"
  role="region"
  aria-labelledby="benefits-heading"
>
  <Container>
    <SectionTitle
      id="benefits-heading"
      eyebrow="¿Por qué elegirnos?"
      title="8 razones para pasarte al sintético"
      description="El césped artificial de Astro Grass no es solo estética. Es una inversión inteligente que te ahorra tiempo, dinero y problemas."
      class="mb-16"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {
        benefits.map((benefit, i) => (
          <article class="group p-6 rounded-2xl hover:bg-grass-50 transition-all duration-300 border border-transparent hover:border-grass-200">
            <div class="w-12 h-12 bg-grass-100 rounded-xl flex items-center justify-center text-grass-600 mb-4 group-hover:bg-grass-500 group-hover:text-white transition-colors duration-300">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <Fragment set:html={iconPaths[benefit.icon] ?? iconPaths['lucide:leaf']} />
              </svg>
            </div>
            <div class="mb-1 flex items-center gap-2">
              <span class="text-xs font-bold text-grass-500 tabular-nums">0{i + 1}</span>
            </div>
            <h3 class="text-base font-bold text-ink-900 mb-2">{benefit.title}</h3>
            <p class="text-sm text-ink-600 leading-relaxed">{benefit.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
