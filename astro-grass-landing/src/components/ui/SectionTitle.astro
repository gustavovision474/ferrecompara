---
import { cn } from '@/lib/utils';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center' | 'right';
  class?: string;
  titleClass?: string;
  light?: boolean;
}

const {
  id,
  eyebrow,
  title,
  description,
  align = 'center',
  class: className,
  titleClass,
  light = false,
} = Astro.props;

const alignMap: Record<string, string> = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};
---

<div class={cn('space-y-4', alignMap[align], className)}>
  {
    eyebrow && (
      <p class={cn('text-sm font-semibold uppercase tracking-widest', light ? 'text-grass-300' : 'text-grass-500')}>
        {eyebrow}
      </p>
    )
  }
  <h2 id={id} class={cn('text-3xl md:text-5xl font-bold leading-tight', light ? 'text-white' : 'text-ink-900', titleClass)}>
    {title}
  </h2>
  {
    description && (
      <p class={cn('text-base md:text-lg leading-relaxed max-w-2xl', align === 'center' && 'mx-auto', light ? 'text-grass-100' : 'text-ink-600')}>
        {description}
      </p>
    )
  }
</div>
